# Research Radar configuration — copy to .env (gitignored) and fill in.
# On the server this file lives at /srv/papersradar/.env

# --- core -------------------------------------------------------------------
# Signing secret for session cookies. Generate: python3 -c "import secrets; print(secrets.token_hex(32))"
APP_SECRET=change-me
# Public base URL used in emailed magic links
BASE_URL=https://papersradar.com
# SQLite database file (WAL mode). Parent dir is created if missing.
DB_PATH=data/papersradar.db
# Structured log directory
LOG_DIR=logs

# --- LLM / embedding providers (free tiers) ---------------------------------
# Judge order: Groq (openai/gpt-oss-120b, validated primary) -> Gemini -> Cerebras -> OpenRouter
GROQ_API_KEY=
GEMINI_API_KEY=
CEREBRAS_API_KEY=
OPENROUTER_API_KEY=

# Active embedder: nemotron-3-embed-1b (OpenRouter API, default) or qwen3-embedding-0.6b
# (local sentence-transformers — only when the server has RAM for torch).
EMBEDDER=nemotron-3-embed-1b

# OpenRouter free-model requests per day (embed stage + chat fallback).
# Default 50 = plain free account. A ONE-TIME $10 credit purchase permanently
# raises the account's free-model cap to 1,000 — if this account has made it,
# set: OPENROUTER_RPD=1000
OPENROUTER_RPD=50

# --- email (magic links + briefing digests) ---------------------------------
# Leave SMTP_HOST empty for DEV MODE: login links are logged and shown on /admin/dev-links,
# and briefing emails are skipped (dashboard-only).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Research Radar <no-reply@papersradar.com>

# Public source-code repository URL. When set, the site shows "source code"
# links and may describe itself as open source; leave EMPTY until the repo is
# actually public (the site must never claim open source falsely).
SOURCE_URL=

# --- pipeline knobs ---------------------------------------------------------
# OpenAlex polite-pool contact + API base (tests point the base at a stub)
OPENALEX_MAILTO=admin@papersradar.com
OPENALEX_BASE=https://api.openalex.org
# Papers judged per user per run (the free-tier user-count knob; see DESIGN.md §5)
JUDGE_SHORTLIST_PER_USER=40
# Briefing selection
BRIEFING_MIN_FIT=6
BRIEFING_MAX_ITEMS=5
# Gather window in days (first run backfills 14)
GATHER_WINDOW_DAYS=4
# Max OpenAlex works paged per concept per run
OPENALEX_MAX_PER_CONCEPT=800

# --- priority journals (2026-08) --------------------------------------------
# A priority-journal paper is auto-queued for judging only when its embedding
# relevance is at or above this percentile of the user's windowed pool —
# chosen empirically against 79 owner-rated papers; see
# analysis/priority_journal_threshold.md before changing.
PRIORITY_JOURNAL_MIN_REL_PCTL=60
# Guaranteed judge slots are ADDITIONAL to JUDGE_SHORTLIST_PER_USER, capped:
PRIORITY_JOURNAL_MAX_PER_USER=10
# Max works pulled per priority journal per gather run
OPENALEX_MAX_PER_JOURNAL=100

# --- AI profile coach (2026-08) ----------------------------------------------
# All coach modes (autofill / suggestions / audit) share one per-user daily
# LLM-call budget; calls go through the normal provider router + counters.
COACH_DAILY_LIMIT=10
# The vote-informed profile audit unlocks at this many votes
AUDIT_MIN_VOTES=20
